# AI Film OS — example environment configuration.
# Copy to `.env` (which is gitignored) and fill in real values.
# Never commit real credentials.

# --- Core ---
# PORT=8000
# FILM_OS_DB=film_os.db
# DATABASE_URL=
# ENABLE_POSTGRESQL=false
# GENERATED_MEDIA_PATH=generated
# Required for fal.ai to fetch uploaded/generated images: the public HTTPS
# URL this service is reachable at. Render sets RENDER_EXTERNAL_URL
# automatically as a fallback if PUBLIC_BASE_URL is left empty.
# PUBLIC_BASE_URL=https://your-service.onrender.com

# --- Object storage for generated media (recommended in production) ---
# GENERATED_MEDIA_PATH above is local disk — on a host without a persistent
# disk (e.g. Render's free tier), every deploy/restart wipes it while
# media_results rows keep pointing at the now-missing files. Setting all of
# the fields below switches image/video storage to an S3-compatible bucket
# instead (Cloudflare R2, AWS S3, and Backblaze B2 all work — they speak the
# same signed-request protocol). Leave any of them empty to keep using local
# disk (a warning is logged on every write in that mode).
#
# OBJECT_STORAGE_ENDPOINT        S3 API endpoint. R2: https://<accountid>.r2.cloudflarestorage.com
#                                 S3: https://s3.<region>.amazonaws.com
#                                 B2: https://s3.<region>.backblazeb2.com
# OBJECT_STORAGE_BUCKET          Bucket name.
# OBJECT_STORAGE_ACCESS_KEY      Access key id for the bucket.
# OBJECT_STORAGE_SECRET_KEY      Secret access key — never log or commit this.
# OBJECT_STORAGE_REGION          Signing region. Defaults to "auto" (R2's own
#                                 default); AWS S3/B2 need their real region,
#                                 e.g. us-east-1 / us-west-004.
# OBJECT_STORAGE_PUBLIC_URL_BASE The public base URL uploaded media is served
#                                 from — a public bucket domain, CDN, or
#                                 custom domain. This is NOT the endpoint
#                                 above (that one requires signed requests on
#                                 every fetch); it's what ends up in
#                                 media_results.url and what fal.ai/Magnific
#                                 fetch from. For R2 this is the bucket's
#                                 public r2.dev URL or a custom domain bound
#                                 to the bucket.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_PUBLIC_URL_BASE=

# --- OpenAI (prompt enhancement / vision) ---
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-5-mini

# --- Magnific (image generation) ---
# MAGNIFIC_API_KEY=
# MAGNIFIC_IMAGE_MODEL=nano-banana-pro
# MAGNIFIC_RESOLUTION=2K

# --- Seedance 2.0 via fal.ai (primary video provider) ---
# Get a key from https://fal.ai/dashboard. Setting this takes priority over
# Kling in get_video_provider().
FAL_API_KEY=
# Optional overrides:
# FAL_API_BASE=https://queue.fal.run
# FAL_SEEDANCE_MODEL=bytedance/seedance-2.0/image-to-video
# FAL_SEEDANCE_FAST_MODEL=bytedance/seedance-2.0/fast/image-to-video
# SEEDANCE_WORKER_POLL_INTERVAL=8

# --- Kling (image-to-video, legacy fallback if FAL_API_KEY is unset) ---
# Both keys are required to enable the Kling video provider. Kling signs a
# short-lived HS256 JWT per request from this AccessKey/SecretKey pair; the
# SecretKey is used only for local signing and is never transmitted.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Optional overrides:
# KLING_API_BASE=https://api-singapore.klingai.com
# KLING_DEFAULT_MODEL=kling-v2-master

# --- Sync.so (optional lip-sync stage) ---
# Leave SYNC_API_KEY empty to keep the lip-sync stage disabled.
# SYNC_API_KEY=
# SYNC_API_BASE=https://api.sync.so
# SYNC_DEFAULT_MODEL=sync-3

# --- Local ComfyUI (optional, free/local "draft mode" video+image provider) ---
# A third provider alongside Kling/Seedance (video) and Magnific (image) —
# never replaces them, only adds a free/fast local option for iterating on a
# shot before committing to a paid external render. Requires ComfyUI running
# on your own machine (see the repo README's local-draft-provider section
# and the SETUP_NOTES.md produced when installing it). Leave
# COMFYUI_ENDPOINT empty to disable entirely — draft mode is then simply
# unavailable, with zero effect on the existing external providers.
#
# COMFYUI_ENDPOINT          Base URL of your local ComfyUI instance's API,
#                           e.g. http://localhost:8188. Only ever reached
#                           from this server — never exposed to the internet.
# COMFYUI_WORKFLOW_LTX_PATH  Local filesystem path to the LTX-2.3 workflow
#                            JSON (produces synced audio too).
# COMFYUI_WORKFLOW_WAN_PATH  Local filesystem path to the Wan 2.2 workflow
#                            JSON (video only, no audio).
# COMFYUI_WORKFLOW_SDXL_PATH Local filesystem path to the SDXL workflow JSON.
# COMFYUI_WORKFLOW_FLUX_PATH Local filesystem path to the Flux.1 workflow
#                            JSON.
# Each workflow file must be a ComfyUI "API format" export whose relevant
# nodes are titled AIFilmOS_Prompt / AIFilmOS_Image / AIFilmOS_Frames /
# AIFilmOS_Seed — see app/services/providers/comfyui_client.py's docstring
# for the exact convention.
# COMFYUI_ENDPOINT=
# COMFYUI_WORKFLOW_LTX_PATH=
# COMFYUI_WORKFLOW_WAN_PATH=
# COMFYUI_WORKFLOW_SDXL_PATH=
# COMFYUI_WORKFLOW_FLUX_PATH=

# --- Media worker tuning (optional) ---
# MEDIA_WORKER_POLL_INTERVAL=3
# MEDIA_WORKER_TASK_TIMEOUT=600
# KLING_WORKER_POLL_INTERVAL=15
# SEEDANCE_WORKER_POLL_INTERVAL=8
# COMFYUI_WORKER_POLL_INTERVAL=2
# MEDIA_WORKER_IDLE_SLEEP=2
# MEDIA_WORKER_ID=
