# AI Film OS — example environment configuration.
# Copy to `.env` (which is gitignored) and fill in real values.
# Never commit real credentials.

# --- Core ---
# PORT=8000
# FILM_OS_DB=film_os.db
# DATABASE_URL=
# ENABLE_POSTGRESQL=false
# GENERATED_MEDIA_PATH=generated
# Required for fal.ai to fetch uploaded/generated images: the public HTTPS
# URL this service is reachable at. Render sets RENDER_EXTERNAL_URL
# automatically as a fallback if PUBLIC_BASE_URL is left empty.
# PUBLIC_BASE_URL=https://your-service.onrender.com

# --- OpenAI (prompt enhancement / vision) ---
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-5-mini

# --- Magnific (image generation) ---
# MAGNIFIC_API_KEY=
# MAGNIFIC_IMAGE_MODEL=nano-banana-pro
# MAGNIFIC_RESOLUTION=2K

# --- Seedance 2.0 via fal.ai (primary video provider) ---
# Get a key from https://fal.ai/dashboard. Setting this takes priority over
# Kling in get_video_provider().
FAL_API_KEY=
# Optional overrides:
# FAL_API_BASE=https://queue.fal.run
# FAL_SEEDANCE_MODEL=bytedance/seedance-2.0/image-to-video
# FAL_SEEDANCE_FAST_MODEL=bytedance/seedance-2.0/fast/image-to-video
# SEEDANCE_WORKER_POLL_INTERVAL=8

# --- Kling (image-to-video, legacy fallback if FAL_API_KEY is unset) ---
# Both keys are required to enable the Kling video provider. Kling signs a
# short-lived HS256 JWT per request from this AccessKey/SecretKey pair; the
# SecretKey is used only for local signing and is never transmitted.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Optional overrides:
# KLING_API_BASE=https://api-singapore.klingai.com
# KLING_DEFAULT_MODEL=kling-v2-master

# --- Sync.so (optional lip-sync stage) ---
# Leave SYNC_API_KEY empty to keep the lip-sync stage disabled.
# SYNC_API_KEY=
# SYNC_API_BASE=https://api.sync.so
# SYNC_DEFAULT_MODEL=sync-3

# --- Media worker tuning (optional) ---
# MEDIA_WORKER_POLL_INTERVAL=3
# MEDIA_WORKER_TASK_TIMEOUT=600
# KLING_WORKER_POLL_INTERVAL=15
# MEDIA_WORKER_IDLE_SLEEP=2
# MEDIA_WORKER_ID=
